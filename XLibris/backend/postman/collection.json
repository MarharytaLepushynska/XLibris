    {
      "name": "Create Request",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Заявку створено\", function () {\n    pm.response.to.have.status(201);\n});\n\nif (pm.response.code === 201) {\n    const request = pm.response.json();\n    pm.collectionVariables.set(\"bookRequestId\", request.id);\n\n    pm.test(\"Заявка має правильні зв'язки та статус\", function () {\n        pm.expect(request.bookId)\n            .to.eql(pm.collectionVariables.get(\"bookId\"));\n\n        pm.expect(request.ownerId)\n            .to.eql(pm.collectionVariables.get(\"ownerId\"));\n\n        pm.expect(request.requesterId)\n            .to.eql(pm.collectionVariables.get(\"requesterId\"));\n\n        pm.expect(request.desiredDurationDays).to.eql(14);\n        pm.expect(request.status).to.eql(\"PENDING\");\n    });\n}"
            ]
          }
        }
      ],

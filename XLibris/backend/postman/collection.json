    {
      "name": "Create Book",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Книгу створено\", function () {\n    pm.response.to.have.status(201);\n});\n\nif (pm.response.code === 201) {\n    const book = pm.response.json();\n    pm.collectionVariables.set(\"bookId\", book.id);\n\n    pm.test(\"Книга належить першому користувачу\", function () {\n        pm.expect(book.ownerId)\n            .to.eql(pm.collectionVariables.get(\"ownerId\"));\n    });\n\n    pm.test(\"Книга доступна\", function () {\n        pm.expect(book.status).to.eql(\"AVAILABLE\");\n    });\n}"
            ]
          }
        }
      ],

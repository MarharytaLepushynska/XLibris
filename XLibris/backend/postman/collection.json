        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"ToreadToreadors from Vasiukivka\",\n  \"description\": \"Book for testing\",\n  \"photoURL\": null,\n  \"ownerId\": \"{{ownerId}}\",\n  \"authorId\": \"{{authorId}}\",\n  \"genreId\": \"{{genreId}}\"\n}",
          "options": {
